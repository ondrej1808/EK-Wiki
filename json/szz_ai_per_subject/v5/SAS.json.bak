      ],
      "answer_parts": [
        {
          "title": "Definice a druhy",
          "text": "$Modulace, které jsou diskrétní v čase. Informace se přenáší pomocí parametrů sledu pulzů o periodě B (šířka pásma odpovídá 2\\pi B).$"
        },
        {
          "title": "Základní typy",
          "text": "PAM (pulzně amplitudová), PWM (pulzně šířková), PPM (pulzně polohová/fázová) a PCM (pulzně kódová modulace využívající kvantování a kódování)."
        }
      ]
